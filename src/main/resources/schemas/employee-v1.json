{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Employee",
  "description": "v1 - core identity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "employeeId": { "type": "string" },
    "firstName":  { "type": "string" },
    "lastName":   { "type": "string" },
    "email":      { "type": "string" }
  },
  "required": ["employeeId", "firstName", "lastName"]
}
