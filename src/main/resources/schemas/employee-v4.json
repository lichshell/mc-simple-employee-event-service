{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Employee",
  "description": "v3 - adds optional location (object) and skills (array)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "employeeId": { "type": "string" },
    "firstName":  { "type": "string" },
    "lastName":   { "type": "string" },
    "email":      { "type": "string" },
    "department": { "type": "string" },
    "jobTitle":   { "type": "string" },
    "hireDate":   { "type": "string", "description": "ISO-8601 date, e.g. 2024-03-18" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "city":    { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "skills": { "type": "array", "items": { "type": "string" } },
    "unit": { "type": "string" }
  },
  "required": ["employeeId", "firstName", "lastName"]
}
